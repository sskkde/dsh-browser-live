{
  "name": "dsh-browser-live",
  "version": "0.9.0",
  "description": "Per-session ZCode-IAB-like browser live view for DeepSeek Harness: provisions a bounded pool of Neko virtual Chromium containers (one CDP endpoint, profile volume, download folder, and viewer path per session), mounts a per-session browser-use provider in attach mode, adds browser_live_* one-shot tools (open/script/recipe/status/fetch/download/state), and auto-opens a right-sidebar live panel while the agent drives the browser.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "lib/",
    "host/",
    "scripts/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "icon": "./icon.svg"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@playwright/mcp": "0.0.80",
    "playwright-core": "1.63.0-alpha-2026-08-31"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-browser-use": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@playwright/mcp": "0.0.80",
    "playwright-core": "1.63.0-alpha-2026-08-31"
  },
  "license": "MIT"
}
